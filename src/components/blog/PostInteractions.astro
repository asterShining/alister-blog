---
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
interface Props { slug: string }
const { slug } = Astro.props;
const iconStyle = "width:1.2rem;height:1.2rem;background:transparent;color:inherit;";
---
<alister-post-interactions data-slug={slug} data-api-base={`${import.meta.env.BASE_URL}api/v1/`}>
  <span class="post-interactions__pill post-interactions__views" aria-label="文章浏览量">
    <MetaIcon icon="material-symbols:visibility-rounded" style={iconStyle} />
    <span>浏览</span> <span data-views>—</span>
  </span>
  <button class="post-interactions__pill" type="button" data-like aria-label="点赞文章" aria-pressed="false" disabled>
    <span data-heart aria-hidden="true">
      <span data-heart-outline><MetaIcon icon="material-symbols:favorite-outline-rounded" style={iconStyle} /></span>
      <span data-heart-filled><MetaIcon icon="material-symbols:favorite-rounded" style={iconStyle} /></span>
    </span>
    <span>喜欢</span> <span data-likes>—</span>
  </button>
  <span class="post-interactions__status" data-status role="status" aria-live="polite"></span>
</alister-post-interactions>
<script>
  import "../../scripts/post-interactions";
</script>
<style>
  alister-post-interactions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin: 0.5rem 0 1.5rem;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--on-surface);
  }
  .post-interactions__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0.375rem 1rem;
    border: 1px solid var(--outline-variant);
    border-radius: 999px;
    background: var(--surface-container);
    color: inherit;
    box-sizing: border-box;
    white-space: nowrap;
  }
  .post-interactions__pill :global(svg), [data-heart] {
    width: 1.2rem;
    height: 1.2rem;
    flex-shrink: 0;
  }
  [data-heart], [data-heart-outline], [data-heart-filled] { display: inline-flex; }
  [data-heart-filled], button[aria-pressed="true"] [data-heart-outline] { display: none; }
  button[aria-pressed="true"] [data-heart-filled] { display: inline-flex; }
  [data-views], [data-likes] {
    display: inline-block;
    min-width: 3ch;
    font-variant-numeric: tabular-nums;
  }
  button {
    background: var(--surface-container-high);
    font: inherit;
    cursor: pointer;
    transition: color 180ms, background-color 180ms, border-color 180ms;
  }
  button:hover:not(:disabled), button[aria-pressed="true"] {
    background: var(--primary-container);
    color: var(--on-primary-container);
    border-color: var(--primary);
  }
  button:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  button:disabled { cursor: default; opacity: 0.8; }
  .post-interactions__status { font-size: 0.75rem; font-weight: 400; color: var(--on-surface-variant); }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
