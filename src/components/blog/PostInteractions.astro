---
interface Props { slug: string }
const { slug } = Astro.props;
---
<alister-post-interactions data-slug={slug} data-api-base={`${import.meta.env.BASE_URL}api/v1/`}>
  <span class="post-interactions__views" aria-label="文章浏览量">浏览 <span data-views>—</span></span>
  <button type="button" data-like aria-label="点赞文章" aria-pressed="false" disabled>
    <span data-heart aria-hidden="true">♡</span> <span data-likes>—</span>
  </button>
  <span class="post-interactions__status" data-status role="status" aria-live="polite"></span>
</alister-post-interactions>
<script>
  import "../../scripts/post-interactions";
</script>
<style>
  alister-post-interactions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin: -0.5rem 0 1.25rem;
    font-size: 0.875rem;
    color: var(--on-surface-variant);
  }
  .post-interactions__views { min-width: 6.5rem; font-variant-numeric: tabular-nums; }
  button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-width: 4.5rem;
    min-height: 44px;
    padding: 0.375rem 0.75rem;
    border: 1px solid var(--outline-variant);
    border-radius: 999px;
    background: transparent;
    color: inherit;
    font: inherit;
    font-variant-numeric: tabular-nums;
    cursor: pointer;
    transition: color 180ms, background-color 180ms, border-color 180ms;
  }
  button:hover:not(:disabled), button[aria-pressed="true"] {
    background: var(--primary-container);
    color: var(--on-primary-container);
    border-color: var(--primary);
  }
  button:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
  button:disabled { cursor: default; opacity: 0.65; }
  .post-interactions__status { font-size: 0.75rem; }
  @media (prefers-reduced-motion: reduce) { button { transition: none; } }
</style>
