---
/**
 * 站点统计侧栏 widget（规格表风格）。
 * 覆盖原 SiteStats，将“动态”修改为“轨迹”，并在客户端动态获取真实轨迹总数。
 *
 * 两个脚本是刻意的分工（详见 docs/performance.md）：
 *
 * 1. 「最近更新」相对时间保持 inline，解析期即执行，避免先闪一下原始日期；
 *    它带 `data-swup-ignore-script`，因为 Swup 的 ScriptsPlugin 每次导航都会
 *    重新执行文档内所有 inline 脚本，而这个标签重跑没有任何意义。
 *
 * 2. 轨迹总数走打包后的 module。ScriptsPlugin 重新插入
 *    script[type="module"] 不会让它二次求值（ES module 每个文档只执行一次），
 *    因此天然免疫 `content:replace` handler 累积。它**必须**保持为“被处理的”
 *    脚本：在这上面加任何额外属性都会让 Astro 原样输出，把裸 `import` 发给浏览器。
 */
import MetaIcon from "@components/atoms/display/MetaIcon.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { formatDateToYYYYMMDD } from "@utils/date-utils";
import { getSiteStats } from "@utils/site-stats";
import { seriesConfig } from "@/config";
import { communityConfig } from "@config/communityConfig.ts";
import type { StatsWidget } from "@/types/sidebarConfig";
import WidgetLayout from "@components/molecules/WidgetLayout.astro";

interface Props {
	class?: string;
	style?: string;
	widget?: StatsWidget;
}

const className = Astro.props.class;
const style = Astro.props.style;

const stats = await getSiteStats();
const fmt = (n: number) => n.toLocaleString("en-US");

const lastActivityText = stats.lastActivity
	? formatDateToYYYYMMDD(new Date(stats.lastActivity))
	: "—";
const todayText = i18n(I18nKey.statsToday);
const yesterdayText = i18n(I18nKey.statsYesterday);
const daysAgoText = i18n(I18nKey.statsDaysAgo);

const rows = [
	{
		icon: "material-symbols:article-outline-rounded",
		label: i18n(I18nKey.statsPosts),
		value: fmt(stats.posts),
	},
	{
		icon: "material-symbols:forum-outline-rounded",
		label: "轨迹",
		value: fmt(stats.moments),
		trajectory: true,
	},
	{
		icon: "material-symbols:folder-outline-rounded",
		label: i18n(I18nKey.categories),
		value: fmt(stats.categories),
	},
	{
		icon: "material-symbols:tag-rounded",
		label: i18n(I18nKey.tags),
		value: fmt(stats.tags),
	},
	...(seriesConfig.enable
		? [
				{
					icon: "material-symbols:auto-stories-outline-rounded",
					label: i18n(I18nKey.series),
					value: fmt(stats.series),
				},
			]
		: []),
	{
		icon: "material-symbols:edit-note-outline-rounded",
		label: i18n(I18nKey.statsWords),
		value: fmt(stats.words),
	},
	{
		icon: "material-symbols:calendar-month-outline-rounded",
		label: i18n(I18nKey.statsDays),
		value: fmt(stats.days),
	},
	{
		icon: "material-symbols:update-rounded",
		label: i18n(I18nKey.statsUpdated),
		value: lastActivityText,
		relative: true,
	},
];
---

<WidgetLayout name={i18n(I18nKey.stats)} id="site-stats" class={className} style={style}>
	<ul
		class="m3-site-stats"
		data-stats-community-enabled={communityConfig.enable ? "true" : "false"}
		data-stats-last-activity={stats.lastActivity ?? ""}
		data-stats-today={todayText}
		data-stats-yesterday={yesterdayText}
		data-stats-days-ago={daysAgoText}
	>
		{rows.map((row) => (
			<li class="m3-site-stats__row">
				<MetaIcon icon={row.icon} />
				<span class="m3-site-stats__label">{row.label}</span>
				<span class="m3-site-stats__rule" aria-hidden="true"></span>
				<span
					class="m3-site-stats__value"
					data-last-update={row.relative ? "" : undefined}
					data-stat-trajectory={row.trajectory ? "" : undefined}
					>{row.value}</span
				>
			</li>
		))}
	</ul>
</WidgetLayout>

<style lang="stylus">
.m3-site-stats
	display: flex
	flex-direction: column
	gap: var(--m3e-space-2)
	margin: 0
	padding: 0
	list-style: none

	&__row
		display: flex
		align-items: center
		gap: var(--m3e-space-2)

	&__label
		font: var(--m3e-type-body-medium)
		font-weight: 500
		color: var(--on-surface-variant)
		white-space: nowrap

	&__rule
		flex: 1
		align-self: flex-end
		margin-bottom: 0.35em
		min-width: 0.75rem
		border-bottom: 2px dotted var(--outline-variant)

	&__value
		font: var(--m3e-type-title-small)
		font-weight: 600
		font-variant-numeric: tabular-nums
		color: var(--on-surface)
		white-space: nowrap
</style>

<script is:inline data-swup-ignore-script>
	(() => {
		const DAY_MS = 86_400_000;
		const dayStart = (d) => new Date(d.getFullYear(), d.getMonth(), d.getDate()).getTime();
		document.querySelectorAll(".m3-site-stats").forEach((root) => {
			const el = root.querySelector("[data-last-update]");
			const iso = root.dataset.statsLastActivity;
			if (!el || !iso) return;
			const diffDays = Math.round((dayStart(new Date()) - dayStart(new Date(iso))) / DAY_MS);
			if (diffDays <= 0) el.textContent = root.dataset.statsToday;
			else if (diffDays === 1) el.textContent = root.dataset.statsYesterday;
			else el.textContent = (root.dataset.statsDaysAgo || "{days}").replace("{days}", String(diffDays));
		});
	})();
</script>

<script>
	/*
	 * Trajectory total for the 统计 widget.
	 *
	 * This used to be an inline script that fetched `/api/v1/community/posts?limit=1`
	 * and registered an `async` handler on the `content:replace` hook. Two things
	 * went wrong with that, both measured against Production:
	 *
	 *  1. Swup's ScriptsPlugin re-executes inline scripts on every navigation, so
	 *     each visit registered one more `content:replace` handler; navigating
	 *     awaited one more API request every time (a fresh session went from
	 *     ~1.7 s to ~8.3 s of blocked settle time within eight navigations).
	 *  2. Swup awaits any hook handler that returns a thenable, so the request
	 *     itself sat on the navigation critical path even on the first visit.
	 *
	 * Now it is a bundled module (modules are evaluated once per document, so
	 * re-inserting the tag cannot re-register anything), it reads through the
	 * shared short-TTL cache, and the hook handler returns `undefined` on
	 * purpose so the fetch is never awaited by the router.
	 */
	import { getCommunityAdapter } from "../../lib/community/adapter";
	import { readCommunityTotal } from "../../lib/community/read-cache";

	function refreshTrajectoryCount(root: HTMLElement) {
		const el = root.querySelector<HTMLElement>("[data-stat-trajectory]");
		if (!el) return;
		void readCommunityTotal(() =>
			getCommunityAdapter()
				.listPosts({ limit: 1 })
				.then((result) => result.total),
		)
			.then((total) => {
				el.textContent = total.toLocaleString("en-US");
			})
			.catch(() => {
				// 容错降级：API 失败时不影响其他统计展示
			});
	}

	function setupSiteStats() {
		const scope = window as Window & { __alisterSiteStatsBound?: boolean };
		if (scope.__alisterSiteStatsBound) return;

		const roots = Array.from(document.querySelectorAll<HTMLElement>(".m3-site-stats")).filter(
			(root) => root.dataset.statsCommunityEnabled === "true",
		);
		if (!roots.length) return;
		scope.__alisterSiteStatsBound = true;

		const sync = () => roots.forEach(refreshTrajectoryCount);
		sync();

		// Returns undefined (not a promise) so Swup never awaits this read.
		const onContentReplace = () => {
			sync();
		};
		if (window.swup?.hooks) {
			window.swup.hooks.on("content:replace", onContentReplace);
		} else {
			document.addEventListener(
				"swup:enable",
				() => window.swup?.hooks?.on("content:replace", onContentReplace),
				{ once: true },
			);
		}
	}

	setupSiteStats();
</script>
