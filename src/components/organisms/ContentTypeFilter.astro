---
/**
 * 首页内容类型筛选（Homepage Content Type Filter）。
 *
 * 语义边界（重要）：
 * - 本组件只属于首页 Feed 的一级内容类型切换：全部 | 文章 | 轨迹；
 * - 它不是站点导航（首页 / 归档），也不是文章分类筛选（日常 / 技术 …）；
 * - 文章分类继续存在于文章卡片、/posts/ 检索视图与分类聚合页；
 * - 视觉沿用首页“小栏目 / pill bar”的容器、圆角与主题 token，但数据语义独立，
 *   不复用 CategoryBar 的首页/归档/分类逻辑。
 *
 * 交互契约（客户端脚本依赖，勿改）：
 * - 容器： #feed-filter-card / #feed-filter-group
 * - 按钮： .feed-filter-btn[data-feed-filter="all" | "article" | "trajectory"]
 * - 选中态： m3-chip--selected（由 PostPage.astro 的 Feed 脚本切换）
 */
import Card from "@components/atoms/display/Card.svelte";

const options = [
	{ value: "all", label: "全部" },
	{ value: "article", label: "文章" },
	{ value: "trajectory", label: "轨迹" },
] as const;

const defaultFilter = "all";
---

<Card
	color="var(--card-bg)"
	radius="l"
	class="content-type-filter onload-animation mb-4 p-2"
	id="content-type-filter-card"
>
	<div id="feed-filter-card" class="content-type-filter__inner">
		<div
			id="feed-filter-group"
			class="content-type-filter__track"
			role="tablist"
			aria-label="内容类型筛选"
		>
			{options.map((option) => (
				<button
					type="button"
					id={`filter-btn-${option.value}`}
					class:list={[
						"m3-chip",
						"feed-filter-btn",
						{ "m3-chip--selected": option.value === defaultFilter },
					]}
					data-feed-filter={option.value}
					role="tab"
					aria-selected={option.value === defaultFilter ? "true" : "false"}
					aria-controls="post-list"
				>
					{option.label}
				</button>
			))}
		</div>
	</div>
</Card>

<style lang="stylus">
.content-type-filter
	display: block

.content-type-filter__inner
	display: flex
	align-items: center
	width: 100%

.content-type-filter__track
	display: flex
	align-items: center
	gap: 0.25rem
	width: 100%
	max-width: 21rem
	padding: 0.25rem
	border-radius: var(--shape-corner-full, 9999px)
	background: var(--btn-regular-bg)
	border: 1px solid var(--outline-variant)
	box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.06)

.content-type-filter__track .feed-filter-btn
	flex: 1 1 0
	min-width: 0
	height: 2.25rem
	padding: 0 0.5rem
	display: inline-flex
	align-items: center
	justify-content: center
	border: 1px solid transparent
	border-radius: var(--shape-corner-full, 9999px)
	background: transparent
	color: var(--on-surface-variant)
	font-size: 0.875rem
	font-weight: 600
	line-height: 1
	letter-spacing: 0.01em
	white-space: nowrap
	cursor: pointer
	user-select: none
	transition: background-color 0.2s cubic-bezier(0.2, 0, 0, 1),
		color 0.2s cubic-bezier(0.2, 0, 0, 1),
		border-color 0.2s cubic-bezier(0.2, 0, 0, 1),
		box-shadow 0.2s cubic-bezier(0.2, 0, 0, 1)

	&:hover:not(.m3-chip--selected)
		background: var(--btn-regular-bg-hover)
		color: var(--on-surface)
		border-color: var(--outline-variant)

	&:active:not(.m3-chip--selected)
		background: var(--btn-regular-bg-active)

	&:focus-visible
		outline: 2px solid var(--primary)
		outline-offset: 2px

	&.m3-chip--selected
		background: var(--primary)
		color: var(--on-primary)
		border-color: transparent
		font-weight: 700
		box-shadow: 0 1px 4px rgba(0, 0, 0, 0.22), 0 1px 2px rgba(0, 0, 0, 0.12)

		&:hover
			background: var(--primary)
			color: var(--on-primary)
			opacity: 0.96

@media (max-width: 360px)
	.content-type-filter__track .feed-filter-btn
		font-size: 0.8125rem
		padding: 0 0.25rem
</style>
